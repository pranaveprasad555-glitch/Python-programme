n = int(input("Enter rows: "))

print("Number triangle:")
for i in range(1, n + 1):
    for j in range(1, i + 1):
        print(j, end=" ")
    print()

print("Inverted star triangle:")
for i in range(n, 0, -1):
    for j in range(i):
        print("*", end=" ")
    print()

print("Pyramid:")
for i in range(1, n + 1):
    for j in range(n - i):
        print(" ", end="")
    for j in range(2 * i - 1):
        print("*", end="")
    print()
