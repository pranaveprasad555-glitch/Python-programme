from datetime import date

today = date.today()
overdue = 0
pending = 0

for line in open("tasks.txt"):
    task, due = line.strip().split(",")
    y, m, d = due.split("-")
    if date(int(y), int(m), int(d)) < today:
        print(task, "- Overdue")
        overdue += 1
    else:
        print(task, "- Pending")
        pending += 1

print("Overdue:", overdue)
print("Pending:", pending)
