m = int(input("Enter rows of A: "))
n = int(input("Enter columns of A: "))
p = int(input("Enter rows of B: "))
q = int(input("Enter columns of B: "))

if n != p:
    print("Multiplication not possible")
else:
    print("Enter matrix A")
    A = [list(map(int, input().split())) for i in range(m)]
    print("Enter matrix B")
    B = [list(map(int, input().split())) for i in range(p)]

    C = [[0] * q for i in range(m)]

    for i in range(m):
        for j in range(q):
            for k in range(n):
                C[i][j] += A[i][k] * B[k][j]

    print("Product:")
    for row in C:
        for x in row:
            print(f"{x:5}", end="")
        print()
