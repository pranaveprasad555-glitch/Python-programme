nums = list(map(int, input("Enter numbers: ").split()))
key = int(input("Enter number to search: "))

pos = -1
for i in range(len(nums)):
    if nums[i] == key:
        pos = i
        break
print("Linear search:", pos)
print("Built-in index:", nums.index(key) if key in nums else -1)

arr = nums[:]
for i in range(len(arr)):
    m = i
    for j in range(i + 1, len(arr)):
        if arr[j] < arr[m]:
            m = j
    arr[i], arr[m] = arr[m], arr[i]

print("Selection sort:", arr)
print("Built-in sorted:", sorted(nums))
print("Same result:", arr == sorted(nums))
