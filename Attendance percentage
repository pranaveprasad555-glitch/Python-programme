attended = int(input("Enter classes attended: "))
total = int(input("Enter total classes: "))

if total <= 0 or attended < 0 or attended > total:
    print("Invalid input")
else:
    percent = attended / total * 100
    print("Attendance:", round(percent, 2), "%")

    if percent >= 75:
        print("Eligible")
    else:
        print("Not eligible")
