def get_grade(marks):
    if marks >= 90:
        return "A"
    elif marks >= 80:
        return "B"
    elif marks >= 70:
        return "C"
    elif marks >= 60:
        return "D"
    elif marks >= 40:
        return "E"
    return "F"

marks = float(input("Enter marks: "))

if marks < 0 or marks > 100:
    print("Invalid marks")
else:
    print("Grade =", get_grade(marks))
